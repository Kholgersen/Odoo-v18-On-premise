<odoo>
    <record id="view_real_property_form" model="ir.ui.view">
        <field name="name">real.property.form</field>
        <field name="model">real.property</field>
        <field name="arch" type="xml">
            <form string="Propiedad">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="state"/>
                        <field name="owner_id"/>
                    </group>
                    <group>
                        <field name="list_price_sale"/>
                        <field name="list_price_rent"/>
                    </group>
                    <group>
                        <field name="sale_product_id" readonly="1"/>
                        <field name="rent_product_id" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Detalles">
                            <group>
                                <field name="street"/>
                                <field name="city"/>
                                <field name="province_id"/>
                                <field name="country_id"/>
                            </group>
                            <group>
                                <field name="area_m2"/>
                                <field name="rooms"/>
                                <field name="bathrooms"/>
                            </group>
                        </page>
                        <page string="Descripción">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_real_property_tree" model="ir.ui.view">
        <field name="name">real.property.tree</field>
        <field name="model">real.property</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="state"/>
                <field name="list_price_sale"/>
                <field name="list_price_rent"/>
                <field name="owner_id"/>
            </tree>
        </field>
    </record>

    <record id="action_real_property" model="ir.actions.act_window">
        <field name="name">Propiedades</field>
        <field name="res_model">real.property</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>